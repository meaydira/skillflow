{
  "name": "skillflow",
  "version": "0.1.0",
  "description": "Run your Claude skills as a dependency graph, with real handoffs between them.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skillflow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "workflows",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "agent",
    "workflow",
    "orchestration",
    "skills",
    "dag",
    "automation"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "commander": "^12.0.0",
    "yaml": "^2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Dilara Bozyilan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meaydira/skillflow.git"
  },
  "homepage": "https://github.com/meaydira/skillflow#readme",
  "bugs": {
    "url": "https://github.com/meaydira/skillflow/issues"
  }
}
