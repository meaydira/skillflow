{
  "name": "skillflow",
  "version": "0.1.0",
  "description": "Run your Claude skills as a dependency graph, with real handoffs between them.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skillflow": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "web",
    "workflows",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "board": "tsx src/cli.ts ui",
    "desktop": "npm run build && electron desktop/main.js",
    "dist": "npm run build && electron-builder --mac"
  },
  "keywords": [
    "claude",
    "agent",
    "workflow",
    "orchestration",
    "skills",
    "dag",
    "automation"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "commander": "^12.0.0",
    "yaml": "^2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Dilara Bozyilan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meaydira/skillflow.git"
  },
  "homepage": "https://github.com/meaydira/skillflow#readme",
  "bugs": {
    "url": "https://github.com/meaydira/skillflow/issues"
  },
  "build": {
    "appId": "ai.skillflow.desktop",
    "productName": "skillflow",
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "web/**/*",
      "desktop/**/*",
      "workflows/**/*",
      "examples/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "asarUnpack": [
      "**/node_modules/@anthropic-ai/**"
    ]
  }
}
